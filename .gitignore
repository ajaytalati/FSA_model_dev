# --- Python ---
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.so

# --- Packaging / install artefacts ---
*.egg-info/
*.egg
build/
dist/
.installed.cfg
pip-wheel-metadata/

# --- pytest / coverage / mypy / ruff caches ---
