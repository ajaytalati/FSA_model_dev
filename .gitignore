LaTex_docs/*.out
LaTex_docs/*.toc
LaTex_docs/*.pdf
LaTex_docs/*.b64
LaTex_docs/*.synctex.gz
LaTex_docs/*.fls
LaTex_docs/*.fdb_latexmk
LaTex_docs/auto/

