# --- venvs (in case someone creates one inside the repo) ---
.venv/
venv/
env/

# --- JAX compilation cache ---
.jax_compilation_cache/

# --- Regenerable scenario outputs ---
# scenarios/ scripts and tests/test_plant_regression_scenarios.py write
# `outputs/fsa/<scenario>/trajectory.npz` + per-channel obs npz on every
# run. They're regenerable, can clutter, and bloat the repo size.
outputs/

